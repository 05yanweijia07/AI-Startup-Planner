{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-startup-planner.local/schemas/project-profile.schema.json",
  "title": "AI Startup Planner Project Profile",
  "description": "Stable identity and baseline facts for one venture. Unknown information is represented explicitly as null or an empty list; it must not be guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "description",
    "industries",
    "business_model",
    "target_customers",
    "team_size",
    "initial_budget",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "industries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "supporting"],
      "properties": {
        "primary": {"type": ["string", "null"]},
        "secondary": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "supporting": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "business_model": {
      "type": ["string", "null"]
    },
    "target_customers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "team_size": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "initial_budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code."
        }
      }
    },
    "development_stage": {
      "type": ["string", "null"],
      "enum": ["idea", "validation", "planning", "pre_launch", "launched", "growth", null]
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
